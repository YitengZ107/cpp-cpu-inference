{
  "version": "2.0.0",
  "tasks": [
    {"label": "Configure Release", "type": "process", "command": "cmake", "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Release"], "problemMatcher": []},
    {"label": "Build Release", "type": "process", "command": "cmake", "args": ["--build", "build", "--config", "Release"], "dependsOn": "Configure Release", "group": {"kind": "build", "isDefault": true}, "problemMatcher": ["$gcc", "$msCompile"]},
    {"label": "Test C++", "type": "process", "command": "ctest", "args": ["--test-dir", "build", "-C", "Release", "--output-on-failure"], "dependsOn": "Build Release", "problemMatcher": []}
  ]
}
